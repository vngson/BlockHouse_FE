<Window x:Class="BlockHouse.Views.Components.CustomMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Custom MessageBox"
        Width="400"
        Height="Auto"
        MinHeight="200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        SizeToContent="Height">
    <Border CornerRadius="16"
            Background="White"
            Margin="16"
            Padding="28">
        <Border.Effect>
            <DropShadowEffect Color="#1A000000" BlurRadius="30" ShadowDepth="6" Opacity="0.15"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title and Icon -->
            <StackPanel Grid.Row="0"
                        Orientation="Vertical"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16">
                <Border Width="56" Height="56" CornerRadius="16"
                        Background="#FAF8F5" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <materialDesign:PackIcon Kind="{Binding IconKind}"
                                             Width="28" Height="28"
                                             HorizontalAlignment="Center"
                                             Foreground="{Binding TitleBrush}"
                                             VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Title}"
                           FontWeight="Bold"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Message -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Message}"
                       TextWrapping="Wrap"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,8"
                       LineHeight="22"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0">
                <ItemsControl ItemsSource="{Binding Buttons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Text}"
                                    Command="{Binding DataContext.ButtonClickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Text}"
                                    Margin="6,0,0,0"
                                    materialDesign:ButtonAssist.CornerRadius="10"
                                    MinWidth="90" Height="38"
                                    Background="{Binding Color}"
                                    FontWeight="SemiBold" FontSize="13"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Border>
</Window>
