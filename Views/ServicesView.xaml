<UserControl x:Class="BlockHouse.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BlockHouse.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Background="Transparent"
                    Style="{StaticResource MaterialDesignFlatButton}" BorderThickness="0"
                    Command="{Binding GoBackCommand}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" Margin="0,0,8,0"
                                             Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="Trở về" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Medium"
                               FontFamily="Segoe UI"/>
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1" TextAlignment="Center" Text="Dịch vụ"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontFamily="Segoe UI"/>
        </Grid>

        <!-- Search & Add -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource SearchBarBorder}">
                    <DockPanel VerticalAlignment="Center">
                        <TextBox Style="{StaticResource SearchTextBox}"
                                 Margin="8,0,0,0"
                                 Width="320"
                                 materialDesign:HintAssist.Hint="Tìm kiếm dịch vụ..."
                                 materialDesign:HintAssist.Background="#EFEBE4"
                                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"/>
                        <materialDesign:PackIcon Kind="Search"
                                                 Width="18" Height="18"
                                                 Foreground="{StaticResource TextMutedBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="4,0,0,0"
                                                 DockPanel.Dock="Right"/>
                    </DockPanel>
                </Border>

                <Button Style="{StaticResource PrimaryActionButton}"
                        Width="80"
                        Margin="10,0,0,0"
                        Command="{Binding SearchCommand}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Tìm" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource GoldFAB}"
                    Command="{Binding AddCommand}"
                    Content="+"/>
        </Grid>

        <!-- Table -->
        <Border Grid.Row="2" Style="{StaticResource TableCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Style="{StaticResource TableHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="STT" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="1" Text="Tên dịch vụ" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="2" Text="Mô tả" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="3" Text="Đơn giá" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="4" Text="Sửa" Style="{StaticResource TableHeaderText}"/>
                    </Grid>
                </Border>

                <!-- Data Items -->
                <ListBox Grid.Row="1" ItemsSource="{Binding ServiceItems}"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0" Background="Transparent"
                         SelectionMode="Single" Focusable="False">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TableRow}">
                                <Grid Height="44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Id}"
                                               FontSize="12" FontWeight="Medium"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               FontFamily="Segoe UI"/>

                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               FontSize="12" FontWeight="Medium"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Left"
                                               Margin="12,0"
                                               TextTrimming="CharacterEllipsis"
                                               FontFamily="Segoe UI"/>

                                    <TextBlock Grid.Column="2" Text="{Binding Description}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Left"
                                               Margin="12,0"
                                               TextTrimming="CharacterEllipsis"
                                               FontFamily="Segoe UI"/>

                                    <TextBlock Grid.Column="3" Text="{Binding PriceDisplay}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#C9A84C"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               FontFamily="Segoe UI"/>

                                    <Button Grid.Column="4"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalAlignment="Center"
                                            Cursor="Hand">
                                        <materialDesign:PackIcon Kind="SquareEditOutline" Width="16" Height="16"
                                                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Pagination -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Style="{StaticResource PaginationBorder}">
                    <Button IsEnabled="{Binding DataContext.IsFirstPageEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" Padding="5"
                            Command="{Binding DataContext.FirstPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <materialDesign:PackIcon Kind="SkipPrevious" Foreground="{StaticResource TextSecondaryBrush}" Width="20" Height="20"/>
                    </Button>
                </Border>

                <Border Style="{StaticResource PaginationBorder}">
                    <Button IsEnabled="{Binding DataContext.IsPrevPageEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Background="Transparent" BorderThickness="0"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" Padding="5"
                            Command="{Binding DataContext.PrevPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <materialDesign:PackIcon Kind="NavigateBefore" Foreground="{StaticResource TextSecondaryBrush}" Width="20" Height="20"/>
                    </Button>
                </Border>

                <Border Style="{StaticResource PaginationBorder}">
                    <TextBox Width="56" BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                             IsReadOnly="True" Cursor="Arrow" Focusable="False"
                             Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"
                             FontFamily="Segoe UI"
                             Text="{Binding CurrentPage}"/>
                </Border>

                <Border Style="{StaticResource PaginationBorder}">
                    <Button IsEnabled="{Binding DataContext.IsNextPageEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Background="Transparent" BorderThickness="0"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" Padding="5"
                            Command="{Binding DataContext.NextPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <materialDesign:PackIcon Kind="NavigateNext" Foreground="{StaticResource TextSecondaryBrush}" Width="20" Height="20"/>
                    </Button>
                </Border>

                <Border Style="{StaticResource PaginationBorder}">
                    <Button IsEnabled="{Binding DataContext.IsLastPageEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Background="Transparent" BorderThickness="0"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" Padding="5"
                            Command="{Binding DataContext.LastPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <materialDesign:PackIcon Kind="SkipNext" Foreground="{StaticResource TextSecondaryBrush}" Width="20" Height="20"/>
                    </Button>
                </Border>
            </StackPanel>

            <TextBlock FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"
                       Text="{Binding ResultText}"
                       FontFamily="Segoe UI"/>
        </Grid>
    </Grid>
</UserControl>
