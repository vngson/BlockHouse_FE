<Window x:Class="BlockHouse.Views.Popup.RevenueByEmployeeAndDate.RevenueByEmployeeAndDateDetailView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Chi tiết doanh thu theo ngày"
        Width="700"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <DropShadowEffect x:Key="PopupDropShadow"
                          Color="Black"
                          BlurRadius="12"
                          ShadowDepth="0"
                          Opacity="0.18"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1976D2"/>
        <SolidColorBrush x:Key="GroupBoxBorderBrush" Color="#DDD"/>
        <SolidColorBrush x:Key="GroupBoxBackground" Color="White"/>

        <!-- Style cho GridViewColumnHeader (để header cột trông hiện đại hơn) -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#EEE"/>
        </Style>

        <!-- Reusable GroupBox Style -->
        <Style x:Key="CustomGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{StaticResource GroupBoxBorderBrush}"/>
            <Setter Property="Background" Value="{StaticResource GroupBoxBackground}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Background="{StaticResource PrimaryBrush}"
                                CornerRadius="8,8,0,0"
                                Padding="10,6"
                                Grid.Row="0">
                                <ContentPresenter ContentSource="Header"
                  RecognizesAccessKey="True"
                  VerticalAlignment="Center"
                  Margin="4,5,0,5">
                                    <ContentPresenter.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" 
                       Foreground="White" 
                       FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </ContentPresenter.ContentTemplate>
                                </ContentPresenter>

                            </Border>

                            <!-- Content area with border that matches header corners -->
                            <Border Grid.Row="1"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,0,8,8"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="#DDD"
            Padding="20"
            SnapsToDevicePixels="True"
            Effect="{StaticResource PopupDropShadow}"
                    MouseDown="Border_MouseDown"
            >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Chi tiết doanh thu"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#333"
                           VerticalAlignment="Center"/>
                <Button Content="✕"
                        Command="{Binding CloseCommand}"
                        Width="28"
                        Height="28"
                        Background="Transparent"
                        Foreground="Gray"
                        BorderThickness="0"
                        FontSize="14"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right"
                        Cursor="Hand"/>
            </DockPanel>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="Ngày:"
               FontSize="14"
               FontWeight="SemiBold"
               Foreground="#333"
               Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Datetime}"
               FontSize="14"
               Foreground="#555"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="Nhân viên" 
   FontSize="14"
 FontWeight="SemiBold"
 Foreground="#333"
 Margin="0,0,8,0"/>

                    <TextBlock
               FontSize="14"
               Foreground="#555" Text="{Binding Employee}" VerticalAlignment="Center"/>

                </StackPanel>


                <!-- Services list -->
                <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Margin="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.ColumnSpan="2"
        Background="Black"
        CornerRadius="4,4,0,0"
        Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Tên dịch vụ"
                   FontWeight="Bold"
                   Foreground="White"/>
                                <TextBlock Grid.Column="1" Text="Số lượng" TextAlignment="Center"
                   FontWeight="Bold"
                   Foreground="White"/>
                            </Grid>
                        </Border>

                        <!-- Data rows -->
                        <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2"
VerticalScrollBarVisibility="Auto"
HorizontalScrollBarVisibility="Disabled"
MaxHeight="200">
                            <!-- có thể chỉnh chiều cao -->
                            <ItemsControl ItemsSource="{Binding Services}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#333"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Quantity}" Foreground="#333" TextAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>


                <!-- Other info -->
                <UniformGrid Columns="2" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Tổng tiền" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Total, StringFormat={}{0:N0} đ}" 
                                   Foreground="DarkGreen"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>

            <!-- Close Button -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Đóng"
                        Command="{Binding CloseCommand}"
                        Width="100"
                        Height="35"
                        Background="Red"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
