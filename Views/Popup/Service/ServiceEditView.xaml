<Window x:Class="BlockHouse.Views.Popup.Service.ServiceEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Sửa dịch vụ"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Width="500">

    <Border CornerRadius="16" Background="White" Margin="16" Padding="28">
        <Border.Effect>
            <DropShadowEffect Color="#1A000000" BlurRadius="30" ShadowDepth="6" Opacity="0.15"/>
        </Border.Effect>
        <Grid MouseDown="Border_MouseDown" Width="400">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                <Border Width="48" Height="48" CornerRadius="14" Background="#EEF2F7" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <materialDesign:PackIcon Kind="BriefcaseEdit" Width="24" Height="24"
                                             Foreground="#4A7FB5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Sửa dịch vụ"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Form Fields -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="Tên dịch vụ *" FontSize="13" FontWeight="Medium"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16"
                         VerticalContentAlignment="Center"
                         materialDesign:HintAssist.Hint="Nhập tên dịch vụ"
                         Style="{StaticResource FormTextBox}"/>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Mô tả" FontSize="13" FontWeight="Medium"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16"
                         VerticalContentAlignment="Center"
                         materialDesign:HintAssist.Hint="Nhập mô tả"
                         Style="{StaticResource FormTextBox}"/>
            </StackPanel>

            <StackPanel Grid.Row="3">
                <TextBlock Text="Đơn giá *" FontSize="13" FontWeight="Medium"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,8"
                         VerticalContentAlignment="Center"
                         materialDesign:HintAssist.Hint="Nhập đơn giá"
                         Style="{StaticResource FormTextBox}"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Đóng"
                        Command="{Binding CloseCommand}"
                        Width="100" Height="38"
                        Background="#EFEBE4" Foreground="{StaticResource TextSecondaryBrush}"
                        BorderThickness="0" Cursor="Hand" FontWeight="Medium" FontSize="13"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Margin="0,0,10,0"/>
                <Button Content="Lưu"
                        Command="{Binding SaveCommand}"
                        Width="100" Height="38"
                        FontWeight="SemiBold" FontSize="13" Cursor="Hand"
                        materialDesign:ButtonAssist.CornerRadius="10">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#C9A84C" Offset="0"/>
                                        <GradientStop Color="#A68A3E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Background" Value="#E5E7EB"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
