<Window x:Class="BlockHouse.Views.Popup.RevenueByEmployee.RevenueAddView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:BlockHouse.ViewModels.Popup.RevenueByEmployee"
        mc:Ignorable="d"
        Title="Thêm đơn hàng mới"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="700"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">
    <Border CornerRadius="16" Background="White" Margin="16" Padding="28">
        <Border.Effect>
            <DropShadowEffect Color="#1A000000" BlurRadius="30" ShadowDepth="6" Opacity="0.15"/>
        </Border.Effect>
        <Grid MouseDown="Border_MouseDown" Width="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                <Border Width="48" Height="48" CornerRadius="14" Background="#FDF8ED" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <materialDesign:PackIcon Kind="ReceiptTextAdd" Width="24" Height="24"
                                             Foreground="#C9A84C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Thêm đơn hàng mới"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- DateTime -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBlock Text="Ngày giờ" FontSize="13" FontWeight="Medium"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <Border Background="#EFEBE4" CornerRadius="10" Height="40" Padding="12,0">
                    <TextBlock Text="{Binding CurrentDateTime, StringFormat='dd/MM/yyyy HH:mm:ss'}"
                               VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                </Border>
            </StackPanel>

            <!-- Employee -->
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <TextBlock Text="Nhân viên" FontSize="13" FontWeight="Medium"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Employees}" DisplayMemberPath="Name"
                          SelectedValuePath="Id" SelectedValue="{Binding SelectedEmployeeId}"
                          Height="40" FontSize="14"/>
            </StackPanel>

            <!-- Services -->
            <StackPanel Grid.Row="3" Margin="0,0,0,8">
                <TextBlock Text="Dịch vụ" FontSize="13" FontWeight="Medium"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,0,0,16">
                <ItemsControl ItemsSource="{Binding OrderServices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding DataContext.Services, RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="Name" SelectedValuePath="Id"
                                          FontSize="13" SelectedValue="{Binding ServiceId}"
                                          Margin="0,0,10,0" VerticalAlignment="Center"/>

                                <Button Grid.Column="1" Width="32" Height="32" Margin="0,0,4,0"
                                        Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                                        Background="#EFEBE4" BorderThickness="0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Minus" Width="16" Height="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Button>

                                <TextBox Grid.Column="2" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalContentAlignment="Center" Width="50" Margin="0,0,4,0"
                                         VerticalAlignment="Center" FontSize="14"/>

                                <Button Grid.Column="3" Width="32" Height="32" Margin="0,0,16,0"
                                        Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        Background="#C9A84C" BorderThickness="0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Foreground="White"/>
                                </Button>

                                <Button Grid.Column="4" Width="32" Height="32"
                                        Command="{Binding DataContext.RemoveServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        Background="#F9DEDE" BorderThickness="0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#C0392B"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="+ Thêm dịch vụ"
                        Background="#EFEBE4" Foreground="{StaticResource TextPrimaryBrush}"
                        BorderThickness="0" FontWeight="Medium" FontSize="13"
                        Command="{Binding AddServiceCommand}" Margin="0,8,0,0"
                        materialDesign:ButtonAssist.CornerRadius="10" Height="36"/>
            </StackPanel>

            <!-- Total -->
            <Border Grid.Row="5" Background="#FDF8ED" CornerRadius="12"
                    Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tổng tiền" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding TotalDisplay}"
                               FontWeight="Bold" FontSize="20"
                               Foreground="#C9A84C" HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Đóng"
                        Command="{Binding CloseCommand}"
                        Width="100" Height="38"
                        Background="#EFEBE4" Foreground="{StaticResource TextSecondaryBrush}"
                        BorderThickness="0" Cursor="Hand" FontWeight="Medium" FontSize="13"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Margin="0,0,10,0"/>
                <Button Content="Lưu"
                        Command="{Binding SaveCommand}"
                        Width="100" Height="38"
                        FontWeight="SemiBold" FontSize="13" Cursor="Hand"
                        materialDesign:ButtonAssist.CornerRadius="10">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#C9A84C" Offset="0"/>
                                        <GradientStop Color="#A68A3E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
