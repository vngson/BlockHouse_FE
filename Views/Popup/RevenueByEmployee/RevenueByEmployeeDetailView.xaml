<Window x:Class="BlockHouse.Views.Popup.RevenueByEmployee.RevenueByEmployeeDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:BlockHouse.ViewModels"
        mc:Ignorable="d"
        Title="Chi tiết doanh thu"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">
    <Border CornerRadius="16" Background="White" Margin="16" Padding="28">
        <Border.Effect>
            <DropShadowEffect Color="#1A000000" BlurRadius="30" ShadowDepth="6" Opacity="0.15"/>
        </Border.Effect>
        <Grid MouseDown="Border_MouseDown" Width="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                <Border Width="48" Height="48" CornerRadius="14" Background="#FDF8ED" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <materialDesign:PackIcon Kind="ReceiptText" Width="24" Height="24"
                                             Foreground="#C9A84C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Chi tiết đơn hàng"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- DateTime -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="Ngày giờ" FontSize="12" FontWeight="Medium"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <Border Background="#EFEBE4" CornerRadius="10" Height="38" Padding="12,0">
                    <TextBlock Text="{Binding DateTime}" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </Border>
            </StackPanel>

            <!-- Services Table -->
            <Border Grid.Row="2" CornerRadius="12" BorderThickness="1" BorderBrush="#E5E7EB" Margin="0,0,0,12" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource TableHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tên dịch vụ" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Left" Margin="16,0"/>
                            <TextBlock Grid.Column="1" Text="Số lượng" Style="{StaticResource TableHeaderText}"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" MaxHeight="200">
                        <ItemsControl ItemsSource="{Binding Services}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TableRow}">
                                        <Grid Margin="16,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Quantity}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Income -->
            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                <TextBlock Text="Thu nhập" FontSize="12" FontWeight="Medium"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <Border Background="#FDF8ED" CornerRadius="10" Height="38" Padding="12,0">
                    <TextBlock Text="{Binding Income}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#C9A84C"/>
                </Border>
            </StackPanel>

            <!-- Employee -->
            <StackPanel Grid.Row="4" Margin="0,0,0,16">
                <TextBlock Text="Nhân viên" FontSize="12" FontWeight="Medium"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <Border Background="#EFEBE4" CornerRadius="10" Height="38" Padding="12,0">
                    <TextBlock Text="{Binding Employee}" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </Border>
            </StackPanel>

            <!-- Close Button -->
            <StackPanel Grid.Row="5" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Content="Đóng"
                        Command="{Binding CloseCommand}"
                        Width="120" Height="38"
                        Background="#EFEBE4" Foreground="{StaticResource TextSecondaryBrush}"
                        BorderThickness="0" Cursor="Hand" FontWeight="Medium" FontSize="13"
                        materialDesign:ButtonAssist.CornerRadius="10"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
