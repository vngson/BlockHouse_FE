<Window x:Class="BlockHouse.Views.Popup.RevenueByEmployee.RevenueByEmployeeDeleteView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:BlockHouse.ViewModels"
        mc:Ignorable="d" 
        Title="Chi tiết doanh thu" 
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        Width="700"
        SizeToContent="Height"
        ResizeMode="NoResize">
    <Grid 
                MouseDown="Border_MouseDown">
        <materialDesign:Card Padding="20" Width="700" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Width="600">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Cột nhãn -->
                    <ColumnDefinition Width="*"/>
                    <!-- Cột giá trị -->
                </Grid.ColumnDefinitions>

                <!-- Tiêu đề -->
                <TextBlock Text="Xác nhận xóa đơn hàng" 
               Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
               Grid.ColumnSpan="2"
               HorizontalAlignment="Center" 
               Margin="0,0,0,20"/>

                <!-- Ngày giờ -->
                <TextBlock Text="Ngày giờ" 
               Style="{StaticResource MaterialDesignBody1TextBlock}" 
               Grid.Row="1" Grid.Column="0"
               Margin="0,0,10,0"
               VerticalAlignment="Center"/>
                <Border Grid.Row="1" Grid.Column="1"
            Background="LightGray" CornerRadius="15" Height="30" Padding="10,0">
                    <TextBlock Text="{Binding DateTime}" VerticalAlignment="Center"/>
                </Border>

                <!-- Các dịch vụ -->

                <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Margin="0,10,0,15" Grid.Row="2" Grid.ColumnSpan="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.ColumnSpan="2"
Background="Black"
CornerRadius="4,4,0,0"
Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Tên dịch vụ"
           FontWeight="Bold"
           Foreground="White"/>
                                <TextBlock Grid.Column="1" Text="Số lượng" TextAlignment="Center"
           FontWeight="Bold"
           Foreground="White"/>
                            </Grid>
                        </Border>

                        <!-- Data rows -->
                        <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Services}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#333"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Quantity}" Foreground="#333" TextAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
                <!--<TextBlock Text="Các dịch vụ" 
               Style="{StaticResource MaterialDesignBody1TextBlock}" 
               Grid.Row="2" Grid.Column="0"
               Margin="0,10,10,0"
               VerticalAlignment="Center"/>
                <Border Grid.Row="2" Grid.Column="1"
            Background="LightGray" CornerRadius="15" Height="30" Padding="10,0"
            Margin="0,10,0,0">
                    <TextBlock Text="{Binding ServicesDisplay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
ToolTipService.ToolTip="{Binding ServicesDisplay}" />
                </Border>-->

                <!-- Thu nhập -->
                <TextBlock Text="Thu nhập" 
               Style="{StaticResource MaterialDesignBody1TextBlock}" 
               Grid.Row="3" Grid.Column="0"
               Margin="0,10,10,0"
               VerticalAlignment="Center"/>
                <Border Grid.Row="3" Grid.Column="1"
            Background="LightGray" CornerRadius="15" Height="30" Padding="10,0"
            Margin="0,10,0,0">
                    <TextBlock Text="{Binding Income}" VerticalAlignment="Center"/>
                </Border>

                <!-- Nhân viên -->
                <TextBlock Text="Nhân viên" 
               Style="{StaticResource MaterialDesignBody1TextBlock}" 
               Grid.Row="4" Grid.Column="0"
               Margin="0,10,10,0"
               VerticalAlignment="Center"/>
                <Border Grid.Row="4" Grid.Column="1"
            Background="LightGray" CornerRadius="15" Height="30" Padding="10,0"
            Margin="0,10,0,0">
                    <TextBlock Text="{Binding Employee}" VerticalAlignment="Center"/>
                </Border>

                <!-- Nút đóng -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
            Grid.Row="5" Grid.ColumnSpan="2">
                    <Button Content="Đóng" 
            Command="{Binding CloseCommand}" 
                            BorderBrush="Black"
            Style="{StaticResource MaterialDesignOutlinedDarkButton}" 
            Margin="0,20,0,0" 
                            Width="100"
            HorizontalAlignment="Center"/>
                    <Button Content="Xác nhận" 
        Command="{Binding DeleteCommand}" 
        Style="{StaticResource MaterialDesignRaisedButton}" 
        Background="Red" 
        Foreground="White" 
        Width="100"
        Margin="20,20,0,0" 
        HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>