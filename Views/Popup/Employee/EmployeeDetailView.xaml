<Window x:Class="BlockHouse.Views.Popup.Employee.EmployeeDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d" 
        Title="Chi tiết nhân viên" 
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Height="400"
        Width="500">

    <Grid MouseDown="Border_MouseDown">
        <materialDesign:Card Padding="20" Width="450" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Width="400">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tiêu đề -->
                <TextBlock Text="Chi tiết nhân viên" 
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                           Grid.ColumnSpan="2"
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,20"/>

                <!-- Tên nhân viên -->
                <TextBlock Text="Họ và tên" 
                           Style="{StaticResource MaterialDesignBody1TextBlock}" 
                           Grid.Row="1" Grid.Column="0"
                           Margin="0,0,10,10"
                           VerticalAlignment="Center"/>
                <Border Grid.Row="1" Grid.Column="1"
                        Background="LightGray" CornerRadius="15" MinHeight="30" Padding="10,0"
                           VerticalAlignment="Center"
                        Margin="0,0,0,10">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Border>

                <!-- Số điện thoại -->
                <TextBlock Text="Số điện thoại" 
                           Style="{StaticResource MaterialDesignBody1TextBlock}" 
                           Grid.Row="2" Grid.Column="0"
                           Margin="0,0,10,10"
                           VerticalAlignment="Center"/>
                <Border Grid.Row="2" Grid.Column="1"
                        Background="LightGray" CornerRadius="15" MinHeight="30" Padding="10,0"
                           VerticalAlignment="Center"
                        Margin="0,0,0,10">
                    <TextBlock Text="{Binding Phone}" VerticalAlignment="Center"/>
                </Border>

                <!-- Trạng thái -->
                <TextBlock Text="Trạng thái" 
                           Style="{StaticResource MaterialDesignBody1TextBlock}" 
                           Grid.Row="3" Grid.Column="0"
                           Margin="0,0,10,10"
                           VerticalAlignment="Center"/>
                <Border Grid.Row="3" Grid.Column="1"
                        Background="LightGray" CornerRadius="15" MinHeight="30" Padding="10,0"
                           VerticalAlignment="Center"
                        Margin="0,0,0,10">
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
                </Border>

                <!-- Thu nhập -->
                <TextBlock Text="Thu nhập" 
                           Style="{StaticResource MaterialDesignBody1TextBlock}" 
                           Grid.Row="4" Grid.Column="0"
                           Margin="0,0,10,10"
                           VerticalAlignment="Center"/>
                <Border Grid.Row="4" Grid.Column="1"
                        Background="LightGray" CornerRadius="15" MinHeight="30" Padding="10,0"
                           VerticalAlignment="Center"
                        Margin="0,0,0,10">
                    <TextBlock Text="{Binding Income}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Border>

                <!-- Ngày tham gia -->
                <TextBlock Text="Ngày tham gia" 
                           Style="{StaticResource MaterialDesignBody1TextBlock}" 
                           Grid.Row="5" Grid.Column="0"
                           Margin="0,0,10,20"
                           VerticalAlignment="Center"/>
                <Border Grid.Row="5" Grid.Column="1"
                        Background="LightGray" CornerRadius="15" MinHeight="30" Padding="10,0"
                           VerticalAlignment="Center"
                        Margin="0,0,0,20">
                    <TextBlock Text="{Binding JoinDate, StringFormat='dd/MM/yyyy'}" VerticalAlignment="Center"/>
                </Border>

                <!-- Nút đóng -->
                <StackPanel Grid.Row="6" Grid.ColumnSpan="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            Margin="0,10,0,0">
                    <Button Content="Đóng"
                            Command="{Binding CloseCommand}"
                            Width="100"
                            Height="35"
                            Background="Red"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>