<UserControl x:Class="BlockHouse.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BlockHouse.Views"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="FocusOuterBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#C9A84C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CenteredSmartHintStyle" TargetType="materialDesign:SmartHint">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Background="Transparent"
                    Style="{StaticResource MaterialDesignFlatButton}" BorderThickness="0"
                    Command="{Binding GoBackCommand}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" Margin="0,0,8,0"
                                             Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="Trở về" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Medium"
                               FontFamily="Segoe UI"/>
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1" TextAlignment="Center" Text="Nhân viên"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontFamily="Segoe UI"/>
        </Grid>

        <!-- Search & Filters -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource GoldFAB}"
                        Margin="12,0,0,0"
                        Command="{Binding AddCommand}"
                        Content="+"/>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource SearchBarBorder}">
                        <DockPanel VerticalAlignment="Center">
                            <TextBox Style="{StaticResource SearchTextBox}"
                                     Margin="8,0,0,0" Width="280"
                                     materialDesign:HintAssist.Hint="Tìm kiếm nhân viên..."
                                     materialDesign:HintAssist.Background="#EFEBE4"/>
                            <materialDesign:PackIcon Kind="Search" Width="18" Height="18"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" Margin="4,0,0,0"
                                                     DockPanel.Dock="Right"/>
                        </DockPanel>
                    </Border>

                    <!-- DatePicker From -->
                    <Border Width="130" BorderThickness="1" Background="#EFEBE4"
                            BorderBrush="#E5E0D8" CornerRadius="10" Margin="12,0,0,0" Padding="8,0">
                        <DatePicker x:Name="DatePickerFrom" Width="100"
                                    SelectedDateFormat="Short"
                                    SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                    VerticalContentAlignment="Center" BorderThickness="0"
                                    Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                                    FontFamily="Segoe UI">
                            <DatePicker.CalendarStyle>
                                <Style TargetType="Calendar" BasedOn="{StaticResource {x:Type Calendar}}">
                                    <Setter Property="Background" Value="White"/>
                                </Style>
                            </DatePicker.CalendarStyle>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Loaded">
                                    <i:InvokeCommandAction Command="{Binding DatePickerLoadedCommand}"
                                                           CommandParameter="{Binding ElementName=DatePickerFrom}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </DatePicker>
                    </Border>

                    <TextBlock Text="-" VerticalAlignment="Center" Margin="8,0"
                               FontSize="16" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Segoe UI"/>

                    <!-- DatePicker To -->
                    <Border Width="130" BorderThickness="1" Background="#EFEBE4"
                            BorderBrush="#E5E0D8" CornerRadius="10" Margin="0,0,0,0" Padding="8,0">
                        <DatePicker x:Name="DatePickerTo" Width="100"
                                    SelectedDateFormat="Short"
                                    SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                    VerticalContentAlignment="Center" BorderThickness="0"
                                    Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                                    FontFamily="Segoe UI">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Loaded">
                                    <i:InvokeCommandAction Command="{Binding DatePickerLoadedCommand}"
                                                           CommandParameter="{Binding ElementName=DatePickerTo}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </DatePicker>
                    </Border>

                    <Button Style="{StaticResource PrimaryActionButton}"
                            Width="80" Margin="12,0,0,0"
                            Command="{Binding SearchCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Tìm" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13"
                                       FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- Table -->
        <Border Grid.Row="2" Style="{StaticResource TableCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Style="{StaticResource TableHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="STT" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="1" Text="Họ và Tên" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="2" Text="Số điện thoại" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="3" Text="Trạng thái" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="4" Text="Thu nhập" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="5" Text="Xem" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="6" Text="Sửa" Style="{StaticResource TableHeaderText}"/>
                    </Grid>
                </Border>

                <!-- Data Items -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding EmployeeItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TableRow}">
                                    <Grid Height="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Id}"
                                                   FontSize="12" FontWeight="Medium"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   FontFamily="Segoe UI"/>

                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   FontSize="12" FontWeight="Medium"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontFamily="Segoe UI"/>

                                        <TextBlock Grid.Column="2" Text="{Binding Phone}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontFamily="Segoe UI"/>

                                        <TextBlock Grid.Column="3" Text="{Binding Status}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   FontFamily="Segoe UI"/>

                                        <TextBlock Grid.Column="4" Text="{Binding IncomeDisplay}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#C9A84C"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   FontFamily="Segoe UI"/>

                                        <Button Grid.Column="5"
                                                Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                HorizontalAlignment="Center" Cursor="Hand">
                                            <materialDesign:PackIcon Kind="Eye" Width="16" Height="16"
                                                                     Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Button>

                                        <Button Grid.Column="6"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                HorizontalAlignment="Center" Cursor="Hand">
                                            <materialDesign:PackIcon Kind="SquareEditOutline" Width="16" Height="16"
                                                                     Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Pagination -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Style="{StaticResource PaginationBorder}">
                    <Button IsEnabled="{Binding DataContext.IsFirstPageEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" Padding="5"
                            Command="{Binding DataContext.FirstPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <materialDesign:PackIcon Kind="SkipPrevious" Foreground="{StaticResource TextSecondaryBrush}" Width="20" Height="20"/>
                    </Button>
                </Border>

                <Border Style="{StaticResource PaginationBorder}">
                    <Button IsEnabled="{Binding DataContext.IsPrevPageEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Background="Transparent" BorderThickness="0"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" Padding="5"
                            Command="{Binding DataContext.PrevPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <materialDesign:PackIcon Kind="NavigateBefore" Foreground="{StaticResource TextSecondaryBrush}" Width="20" Height="20"/>
                    </Button>
                </Border>

                <Border Style="{StaticResource PaginationBorder}">
                    <TextBox Width="56" BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                             IsReadOnly="True" Cursor="Arrow" Focusable="False"
                             Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"
                             FontFamily="Segoe UI"
                             Text="{Binding CurrentPage}"/>
                </Border>

                <Border Style="{StaticResource PaginationBorder}">
                    <Button IsEnabled="{Binding DataContext.IsNextPageEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Background="Transparent" BorderThickness="0"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" Padding="5"
                            Command="{Binding DataContext.NextPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <materialDesign:PackIcon Kind="NavigateNext" Foreground="{StaticResource TextSecondaryBrush}" Width="20" Height="20"/>
                    </Button>
                </Border>

                <Border Style="{StaticResource PaginationBorder}">
                    <Button IsEnabled="{Binding DataContext.IsLastPageEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Background="Transparent" BorderThickness="0"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" Padding="5"
                            Command="{Binding DataContext.LastPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <materialDesign:PackIcon Kind="SkipNext" Foreground="{StaticResource TextSecondaryBrush}" Width="20" Height="20"/>
                    </Button>
                </Border>
            </StackPanel>

            <TextBlock FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"
                       Text="{Binding ResultText}"
                       FontFamily="Segoe UI"/>
        </Grid>
    </Grid>
</UserControl>
