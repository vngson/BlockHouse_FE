<UserControl x:Class="BlockHouse.Views.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Tổng quan" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Xin chào! Đây là tổng quan hoạt động cửa hàng của bạn."
                       Style="{StaticResource SectionSubtitle}"/>
        </StackPanel>

        <!-- Stat Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Service Count -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Lượt dịch vụ" FontSize="12" FontWeight="Medium"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding TotalServiceSales}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12"
                            Background="#EEF2F7" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CartArrowUp" Width="22" Height="22"
                                                 Foreground="#4A7FB5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Total Revenue -->
            <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="5,0,5,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tổng doanh thu" FontSize="12" FontWeight="Medium"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:N0}đ}" FontSize="28" FontWeight="Bold"
                                   Foreground="#C9A84C" FontFamily="Segoe UI"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12"
                            Background="#FDF8ED" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CurrencyUsd" Width="22" Height="22"
                                                 Foreground="#C9A84C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Growth -->
            <Border Grid.Column="2" Style="{StaticResource ModernCard}" Margin="10,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tăng trưởng" FontSize="12" FontWeight="Medium"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding GrowthPercent}" FontSize="28" FontWeight="Bold"
                                       Foreground="#3D8B5E" FontFamily="Segoe UI"/>
                            <TextBlock Text="%" FontSize="28" FontWeight="Bold" Foreground="#3D8B5E"
                                       Margin="2,0,0,0" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12"
                            Background="#ECF4EE" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="TrendingUp" Width="22" Height="22"
                                                 Foreground="#3D8B5E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Employee Ranking -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Margin="0,0,0,20">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Trophy" Width="18" Height="18"
                                             Foreground="#C9A84C" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Xếp hạng doanh thu" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </DockPanel>

                <ListBox ItemsSource="{Binding TopEmployees}" Background="Transparent" BorderThickness="0"
                         Padding="0" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False" VirtualizingStackPanel.IsVirtualizing="False"
                         IsHitTestVisible="False" Focusable="False" HorizontalAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FAF8F5" CornerRadius="10" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                            Background="#EFEBE4" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Image Source="{Binding RankImagePath}" Width="22" Height="22"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2" Text="{Binding Revenue, StringFormat={}{0:N0}đ}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#C9A84C"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Account" Width="12" Height="12"
                                                                 Foreground="{StaticResource TextMutedBrush}"
                                                                 VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <TextBlock Text="{Binding OrderCount}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text=" khách" FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Chart -->
        <Border Grid.Row="3" Style="{StaticResource ModernCard}">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <materialDesign:PackIcon DockPanel.Dock="Left" Kind="ChartLine" Width="18" Height="18"
                                             Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Doanh thu theo tháng" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </DockPanel>
                <lvc:CartesianChart Series="{Binding RevenueSeries}" LegendLocation="Bottom" Height="220">
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Labels="{Binding Months}" MinValue="0" LabelsRotation="0">
                            <lvc:Axis.Separator>
                                <lvc:Separator StrokeThickness="1" Step="1" Stroke="#F0EDE6"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis LabelFormatter="{Binding YFormatter}" MinValue="0">
                            <lvc:Axis.Separator>
                                <lvc:Separator StrokeThickness="1" Stroke="#F0EDE6"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
