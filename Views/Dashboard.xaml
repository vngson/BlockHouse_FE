<UserControl x:Class="BlockHouse.Views.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0"
                       Text="Tổng quan"
                       FontSize="22"
                       HorizontalAlignment="Stretch"
                       TextAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#2C3E50"
                       Margin="0,0,0,10"/>

            <!-- Employee ranking -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Xếp hạng doanh thu theo nhân viên"
               FontSize="16"
               FontWeight="Medium"
               Foreground="#37474F"
               Margin="0,0,0,10"
               Grid.Row="0"/>

                <ListBox Grid.Row="1"
         ItemsSource="{Binding TopEmployees}"
         Background="Transparent"
         BorderThickness="0"
         Padding="0"
         ScrollViewer.VerticalScrollBarVisibility="Disabled"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         ScrollViewer.CanContentScroll="False"
         VirtualizingStackPanel.IsVirtualizing="False"
         IsHitTestVisible="False"
         Focusable="False"
         HorizontalAlignment="Stretch"
         VerticalAlignment="Top">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <!-- DataTemplate giữ nguyên -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                        CornerRadius="12"
                        Padding="12"
                        HorizontalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Background" Value="#BBDEFB"/>
                                                <!-- xanh khi chọn -->
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFocused, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Background" Value="#E3F2FD"/>
                                                <!-- xanh nhạt khi focus -->
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0"
                               Source="{Binding RankImagePath}"
                               Width="32"
                               Height="32"
                               Margin="15,0,15,0"
                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                               HorizontalAlignment="Center"
                                   Foreground="#263238"
                                   VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Revenue, StringFormat={}{0:N0}đ}"
                                       FontSize="14"
                                       Foreground="#455A64"
                                               HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding OrderCount}"
                                       FontSize="14"
                                       Margin="0,0,5,0"
                                       Foreground="#455A64"
                                       VerticalAlignment="Center"/>
                                        <TextBlock Text="khách"
                                       FontSize="14"
                                       Foreground="#455A64"
                                       VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <!-- Stats section -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Stat 1 -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" Margin="5" Padding="15" MinHeight="100"
                        HorizontalAlignment="Center"
                        Effect="{DynamicResource materialDesignElevation1}">
                    <Grid Width="200">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Lượt dịch vụ"
                                       FontSize="14"
                                       Foreground="#37474F"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding TotalServiceSales}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#263238"/>
                        </StackPanel>
                        <materialDesign:PackIcon Grid.Column="1"
                                                 Kind="CartArrowUp"
                                                 Width="32"
                                                 Height="32"
                                                 Foreground="#546E7A"
                                                 VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Stat 2 -->
                <Border Grid.Column="1" Background="White" CornerRadius="12" Margin="5" Padding="15" MinHeight="100" HorizontalAlignment="Center"
                        Effect="{DynamicResource materialDesignElevation1}">
                    <Grid  Width="200">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tổng doanh thu"
                                       FontSize="14"
                                       Foreground="#37474F"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:N0}đ}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#F9A825"/>
                        </StackPanel>
                        <materialDesign:PackIcon Grid.Column="1"
                                                 Kind="CurrencyUsd"
                                                 Width="32"
                                                 Height="32"
                                                 Foreground="#546E7A"
                                                 VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Stat 3 -->
                <Border Grid.Column="2" Background="White" CornerRadius="12" Margin="5" Padding="15" MinHeight="100" HorizontalAlignment="Center"
                        Effect="{DynamicResource materialDesignElevation1}">
                    <Grid  Width="200">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tăng trưởng"
                                       FontSize="14"
                                       Foreground="#37474F"
                                       Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding GrowthPercent}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#43A047"/>
                                <TextBlock Text="%"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#43A047"
                                           Margin="4,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <materialDesign:PackIcon Grid.Column="1"
                                                 Kind="ChartLine"
                                                 Width="32"
                                                 Height="32"
                                                 Foreground="#546E7A"
                                                 VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Chart -->
            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <TextBlock Text="Doanh thu theo tháng"
                           FontSize="16"
                           FontWeight="Medium"
                           Foreground="#37474F"
                           Margin="0,0,0,10"/>

                <Border Background="White" CornerRadius="12" Padding="10"
                        Effect="{DynamicResource materialDesignElevation1}">
                    <lvc:CartesianChart Series="{Binding RevenueSeries}"
                                        LegendLocation="Bottom"
                                        Height="200"
                                        Margin="0">
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Labels="{Binding Months}" 
                  MinValue="0"
                  LabelsRotation="-45">
                            <lvc:Axis.Separator>
                                <lvc:Separator StrokeThickness="1" Step="1"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                            <lvc:Axis LabelFormatter="{Binding YFormatter}" MinValue="0" />
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Border>
            </StackPanel>
        </Grid>
</UserControl>
