<UserControl x:Class="BlockHouse.Views.RevenueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BlockHouse.Views"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="FocusOuterBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#C9A84C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Background="Transparent"
                    Style="{StaticResource MaterialDesignFlatButton}" BorderThickness="0"
                    Command="{Binding GoBackCommand}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,6,0"
                                             Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="Trở về" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium" FontSize="12"/>
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" TextAlignment="Center" Text="Doanh thu"
                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
        </Grid>

        <!-- Search & Filters -->
        <Grid Grid.Row="1" Margin="0,0,0,14" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource SearchBarBorder}">
                    <DockPanel VerticalAlignment="Center">
                        <TextBox Style="{StaticResource SearchTextBox}"
                                 Margin="8,0,0,0" Width="280"
                                 Text="{Binding SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Tìm kiếm đơn hàng..."
                                 materialDesign:HintAssist.Background="#EFEBE4"
                                 materialDesign:TextFieldAssist.HasClearButton="True">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <materialDesign:PackIcon Kind="Search" Width="16" Height="16"
                                                 Foreground="{StaticResource TextMutedBrush}"
                                                 VerticalAlignment="Center" Margin="4,0,0,0" DockPanel.Dock="Right"/>
                    </DockPanel>
                </Border>

                <Border Width="125" BorderThickness="1" Background="#EFEBE4"
                        BorderBrush="#E5E0D8" CornerRadius="8" Margin="10,0,0,0" Padding="6,0">
                    <DatePicker x:Name="DatePickerFrom" Width="100" SelectedDateFormat="Short"
                                SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                VerticalContentAlignment="Center" BorderThickness="0"
                                Foreground="{StaticResource TextPrimaryBrush}" FontSize="12">
                        <DatePicker.CalendarStyle>
                            <Style TargetType="Calendar" BasedOn="{StaticResource {x:Type Calendar}}">
                                <Setter Property="Background" Value="White"/>
                            </Style>
                        </DatePicker.CalendarStyle>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Loaded">
                                <i:InvokeCommandAction Command="{Binding DatePickerLoadedCommand}"
                                                       CommandParameter="{Binding ElementName=DatePickerFrom}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </DatePicker>
                </Border>

                <TextBlock Text="-" VerticalAlignment="Center" Margin="6,0" FontSize="14"
                           Foreground="{StaticResource TextMutedBrush}"/>

                <Border Width="125" BorderThickness="1" Background="#EFEBE4"
                        BorderBrush="#E5E0D8" CornerRadius="8" Padding="6,0">
                    <DatePicker x:Name="DatePickerTo" Width="100" SelectedDateFormat="Short"
                                SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                VerticalContentAlignment="Center" BorderThickness="0"
                                Foreground="{StaticResource TextPrimaryBrush}" FontSize="12">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Loaded">
                                <i:InvokeCommandAction Command="{Binding DatePickerLoadedCommand}"
                                                       CommandParameter="{Binding ElementName=DatePickerTo}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </DatePicker>
                </Border>

                <Button Style="{StaticResource PrimaryActionButton}" Width="72" Margin="10,0,0,0"
                        Command="{Binding SearchCommand}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Magnify" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Tìm" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tabs & Add -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="Theo đơn hàng" Style="{StaticResource TabButtonStyle}"
                        Background="{Binding EmployeeBtnBackground}"
                        Command="{Binding DataContext.EmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <Button Content="Theo ngày" Style="{StaticResource TabButtonStyle}"
                        Background="{Binding DateBtnBackground}"
                        Command="{Binding DataContext.DateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <Button Content="Theo NV/Ngày" Style="{StaticResource TabButtonStyle}"
                        Background="{Binding EmpADateBackground}"
                        Command="{Binding DataContext.EmployeeAndDateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <Button Content="Theo NV/Tháng" Style="{StaticResource TabButtonStyle}"
                        Background="{Binding EmpAMonthBackground}"
                        Command="{Binding DataContext.EmployeeAndMonthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </StackPanel>

            <Button Grid.Column="1" Style="{StaticResource GoldFAB}" Margin="12,0"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{Binding AddCommand}" Visibility="{Binding AddBtnVisibility}" Content="+"/>
        </Grid>

        <!-- ===== TABLE CONTAINER (all tabs share same wrapper, only content grid changes) ===== -->

        <!-- BY ORDER -->
        <Border Grid.Row="3" Style="{StaticResource TableCard}"
                Visibility="{Binding DataContext.ByOrderGridVisibility, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource TableHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/><ColumnDefinition Width="60"/><ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="STT" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="1" Text="Ngày" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Left" Margin="10,0"/>
                        <TextBlock Grid.Column="2" Text="Dịch vụ" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="3" Text="Thu nhập" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="4" Text="Nhân viên" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="5" Text="Xem" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="6" Text="Sửa" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="7" Text="Xóa" Style="{StaticResource TableHeaderText}"/>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" x:Name="sv1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding RevenueItems}" Width="{Binding ActualWidth, ElementName=sv1}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TableRow}">
                                    <Grid Height="42">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/><ColumnDefinition Width="60"/><ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Datetime}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" Margin="10,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ServicesDisplay}" FontSize="11"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" Margin="10,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding TotalDisplay}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#C9A84C" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding EmployeeName}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="5" Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Cursor="Hand">
                                            <materialDesign:PackIcon Kind="Eye" Width="16" Height="16" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Button>
                                        <Button Grid.Column="6" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Cursor="Hand">
                                            <materialDesign:PackIcon Kind="SquareEditOutline" Width="16" Height="16" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Button>
                                        <Button Grid.Column="7" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Cursor="Hand">
                                            <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Foreground="#C0392B"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- BY DATE -->
        <Border Grid.Row="3" Style="{StaticResource TableCard}"
                Visibility="{Binding DataContext.ByDateGridVisibility, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource TableHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="STT" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="1" Text="Ngày" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Left" Margin="10,0"/>
                        <TextBlock Grid.Column="2" Text="Dịch vụ" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="3" Text="Thu nhập" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="4" Text="Xem" Style="{StaticResource TableHeaderText}"/>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" x:Name="sv" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding RevenueItems}" Width="{Binding ActualWidth, ElementName=sv}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TableRow}">
                                    <Grid Height="42">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Datetime}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" Margin="10,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ServicesDisplay}" FontSize="11"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" Margin="10,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding TotalDisplay}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#C9A84C" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <Button Grid.Column="4" Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Cursor="Hand">
                                            <materialDesign:PackIcon Kind="Eye" Width="16" Height="16" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- BY EMPLOYEE -->
        <Border Grid.Row="3" Style="{StaticResource TableCard}"
                Visibility="{Binding DataContext.ByEmployeeGridVisibility, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource TableHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="STT" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="1" Text="Ngày" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Left" Margin="10,0"/>
                        <TextBlock Grid.Column="2" Text="Dịch vụ" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="3" Text="Thu nhập" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="4" Text="Nhân viên" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="5" Text="Xem" Style="{StaticResource TableHeaderText}"/>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" x:Name="sv2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding RevenueItems}" Width="{Binding ActualWidth, ElementName=sv2}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TableRow}">
                                    <Grid Height="42">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Datetime}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" Margin="10,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ServicesDisplay}" FontSize="11"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" Margin="10,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding TotalDisplay}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#C9A84C" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding EmployeeName}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="5" Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Cursor="Hand">
                                            <materialDesign:PackIcon Kind="Eye" Width="16" Height="16" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- BY EMPLOYEE/MONTH -->
        <Border Grid.Row="3" Style="{StaticResource TableCard}"
                Visibility="{Binding DataContext.ByEmployeeAMonthGridVisibility, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource TableHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="STT" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="1" Text="Tháng" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Left" Margin="10,0"/>
                        <TextBlock Grid.Column="2" Text="Số đơn hàng" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="3" Text="Thu nhập" Style="{StaticResource TableHeaderText}"/>
                        <TextBlock Grid.Column="4" Text="Nhân viên" Style="{StaticResource TableHeaderText}"/>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" x:Name="sv3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding RevenueItems}" Width="{Binding ActualWidth, ElementName=sv3}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TableRow}">
                                    <Grid Height="42">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Month}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" Margin="10,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding OrderCount}" FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding TotalDisplay}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#C9A84C" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding EmployeeName}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Pagination -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Style="{StaticResource PaginationBorder}">
                    <Button IsEnabled="{Binding DataContext.IsFirstPageEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" Padding="4"
                            Command="{Binding DataContext.FirstPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <materialDesign:PackIcon Kind="SkipPrevious" Foreground="{StaticResource TextSecondaryBrush}" Width="18" Height="18"/>
                    </Button>
                </Border>
                <Border Style="{StaticResource PaginationBorder}">
                    <Button IsEnabled="{Binding DataContext.IsPrevPageEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Background="Transparent" BorderThickness="0"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" Padding="4"
                            Command="{Binding DataContext.PrevPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <materialDesign:PackIcon Kind="NavigateBefore" Foreground="{StaticResource TextSecondaryBrush}" Width="18" Height="18"/>
                    </Button>
                </Border>
                <Border Style="{StaticResource PaginationBorder}">
                    <TextBox Width="50" BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                             IsReadOnly="True" Cursor="Arrow" Focusable="False"
                             Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"
                             Text="{Binding CurrentPage}"/>
                </Border>
                <Border Style="{StaticResource PaginationBorder}">
                    <Button IsEnabled="{Binding DataContext.IsNextPageEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Background="Transparent" BorderThickness="0"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" Padding="4"
                            Command="{Binding DataContext.NextPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <materialDesign:PackIcon Kind="NavigateNext" Foreground="{StaticResource TextSecondaryBrush}" Width="18" Height="18"/>
                    </Button>
                </Border>
                <Border Style="{StaticResource PaginationBorder}">
                    <Button IsEnabled="{Binding DataContext.IsLastPageEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Background="Transparent" BorderThickness="0"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" Padding="4"
                            Command="{Binding DataContext.LastPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <materialDesign:PackIcon Kind="SkipNext" Foreground="{StaticResource TextSecondaryBrush}" Width="18" Height="18"/>
                    </Button>
                </Border>
            </StackPanel>
            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"
                       Text="{Binding ResultText}"/>
        </Grid>
    </Grid>
</UserControl>
