<UserControl x:Class="BlockHouse.Views.RevenueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BlockHouse.Views"
             xmlns:materialDesign ="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Background="Transparent" Style="{StaticResource MaterialDesignFlatButton}" BorderThickness="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20" Margin="0,0,8,0" Background="Transparent"
             Foreground="Black"/>
                    <TextBlock Text="Trở về" VerticalAlignment="Center"
Foreground="Black"/>
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1" TextAlignment="Center" Text="Doanh thu" FontSize="22" FontWeight="SemiBold"/>
        </Grid>

        <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,20">
            <Border Background="#80EFE8D8" CornerRadius="20" Padding="10">
                <DockPanel VerticalAlignment="Center">

                    <!-- Ô nhập liệu -->
                    <TextBox
    Style="{StaticResource MaterialDesignTextBox}"
    Background="Transparent"
    BorderThickness="0"
    VerticalContentAlignment="Center"
    Foreground="Black"
    FontSize="14" 
                        Margin="10,0,0,0"
    Width="350"
    materialDesign:HintAssist.Hint="Tìm kiếm"
    materialDesign:HintAssist.Background="Transparent"
    materialDesign:TextFieldAssist.UnderlineBrush="Gray"
/>


                    <!-- Icon tìm kiếm (bên phải) -->
                    <materialDesign:PackIcon Kind="Search"
                                 Width="20"
                                 Height="20"
                                 Foreground="Black"
                                 VerticalAlignment="Center"
                                 Margin="5,0,0,0"
                                 DockPanel.Dock="Right"/>
                </DockPanel>
            </Border>

        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border CornerRadius="20" Background="Black" BorderThickness="0" BorderBrush="Transparent" Width="200" Margin="0,0,20,0">
                    <Button Content="Theo nhân viên" 
                Style="{StaticResource MaterialDesignFlatButton}"
                Background="Transparent"
                BorderBrush="Transparent"
                Foreground="White"/>
                </Border>

                <!-- Nút theo tháng -->
                <Border CornerRadius="20" Background="Black" BorderThickness="0" BorderBrush="Transparent" Width="200">
                    <Button Content="Theo tháng" 
                Style="{StaticResource MaterialDesignFlatButton}"
                Background="Transparent"
                BorderBrush="Transparent"
                Foreground="White"/>
                </Border>
            </StackPanel>

            <Border Width="40" Height="40" Grid.Column="1" Margin="20,0"
        CornerRadius="20"
        Background="Black"
        BorderThickness="0"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
                <Button Background="Transparent"
            BorderBrush="Transparent"
            Foreground="White"
            Content="+"
            FontSize="20"
            Style="{StaticResource MaterialDesignFloatingActionMiniButton}"/>
            </Border>


        </Grid>

        <Grid Grid.Row="3" Margin="20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Data Items -->
            </Grid.RowDefinitions>

            <!-- Table Header -->
            <Border Grid.Row="0" 
                    Background="Black" 
                    BorderThickness="1"
                    BorderBrush="Black"
                    CornerRadius="5,5,0,0" 
                    Height="40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="STT" 
                               Foreground="White"
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center" 
                               FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" 
                               Text="Ngày" 
                               Foreground="White"
                               VerticalAlignment="Center" 
                               Margin="10,0" 
                               FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" 
                               Text="Dịch vụ" 
                               Foreground="White"
                               VerticalAlignment="Center" 
                               Margin="10,0" 
                               FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="3" 
                               Text="Thu nhập" 
                               Foreground="White"
                               VerticalAlignment="Center" 
                               TextAlignment="Center"
                               Margin="10,0" 
                               FontWeight="SemiBold" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" 
                               Text="Nhân Viên" 
                               Foreground="White"
                               TextAlignment="Center"
                               VerticalAlignment="Center" 
                               Margin="10,0" 
                               FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="5" 
                               Text="Xem" 
                               Foreground="White"
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center" 
                               FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="6" 
                               Text="Sửa" 
                               Foreground="White"
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center" 
                               FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="7" 
                               Text="Xóa" 
                               Foreground="White"
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center" 
                               FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <!-- Data Items -->
            <Border Grid.Row="1" 
                    BorderThickness="0,0,0,0" 
                    BorderBrush="LightGray" 
                    CornerRadius="0,0,5,5">
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding RevenueItems}" 
                                  BorderThickness="0" 
                                  Padding="0">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Style.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                       
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" 
                                        BorderBrush="LightGray" 
                                        Background="#E9E9E9"
                                        Margin="0,2"
                                        Padding="0">
                                    <Grid Height="40">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- STT -->
                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding Id}" 
                                                   VerticalAlignment="Center" 
                                                   HorizontalAlignment="Center"/>

                                        <!-- Ngày -->
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding Datetime}" 
                                                   VerticalAlignment="Center" 
                                                   Margin="10,0"/>

                                        <!-- Dịch vụ -->
                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding ServicesDisplay}" 
                                                   VerticalAlignment="Center" 
                                                   Margin="10,0" 
                                                   TextWrapping="Wrap"/>

                                        <!-- Thu nhập -->
                                        <TextBlock Grid.Column="3" 
                                                   Text="{Binding Total}" 
                                                   VerticalAlignment="Center" 
                                                   Margin="10,0" 
                               TextAlignment="Center"
                                                   HorizontalAlignment="Center"/>

                                        <!-- Nhân viên -->
                                        <TextBlock Grid.Column="4" 
                                                   Text="{Binding EmployeeName}" 
                               TextAlignment="Center"
                                                   VerticalAlignment="Center" 
                                                   Margin="10,0"/>

                                        <!-- Xem Button -->
                                        <Button Grid.Column="5" 
                                                Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" 
                                                
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                BorderThickness="0"
                                                HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Eye" 
                                                                     Width="20" 
                                                                     Height="20" 
                                                                     Foreground="Black"/>
                                        </Button>

                                        <!-- Sửa Button -->
                                        <Button Grid.Column="6" 
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" 
                                                
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                BorderThickness="0"
                                                HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="SquareEditOutline" 
                                                                     Width="20" 
                                                                     Height="20" 
                                                                     Foreground="Black"/>
                                        </Button>

                                        <!-- Xóa Button -->
                                        <Button Grid.Column="7" 
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" 
                                                BorderThickness="0"
                                                
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Delete" 
                                                                     Width="20" 
                                                                     Height="20" 
                                                                     Foreground="Red"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

    </Grid>
</UserControl>
