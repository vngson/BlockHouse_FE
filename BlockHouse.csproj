<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Keep the existing Visual Studio compatible; release script explicitly targets .NET 10. -->
    <TargetFramework Condition="'$(BlockHouseRelease)' != 'true'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(BlockHouseRelease)' == 'true'">net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <ApplicationIcon>Assets\blockhouse_logo.ico</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <BackendExecutable>$(MSBuildProjectDirectory)\..\Blockhouse_BE\dist\BE.exe</BackendExecutable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <Compile Include="App.xaml.cs;DesktopWindow.xaml.cs;DesktopWindow.Chrome.cs;Services\DesktopTheme.cs;Services\BackendHost.cs;Services\BackendProcessService.cs;Services\RememberedLoginStore.cs" />
    <Page Include="DesktopWindow.xaml" />
    <Resource Include="Assets\blockhouse_logo.ico" />
    <Resource Include="Assets\blockhouse_logo_color.png" />
    <Resource Include="Assets\BebasNeue-Regular.ttf" />
    <Content Include="$(BackendExecutable)" Link="BE.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(BackendExecutable)')" />
    <Content Include="..\Blockhouse_BE\backend-config.example.json" Link="backend-config.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Condition="'$(Configuration)' == 'Debug'" />
    <Content Include="web\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <UpToDateCheckInput Include="web\index.html" />
  </ItemGroup>
  <Target Name="CheckDesktopDependencies" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(BackendExecutable)')" Text="Missing packaged BE.exe. Run build-desktop.ps1 to prepare the backend first." />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\web\index.html')" Text="Missing offline UI. Run build-desktop.ps1 to prepare the web bundle first." />
  </Target>
</Project>