<Window x:Class="BlockHouse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:BlockHouse"
        xmlns:viewModel="clr-namespace:BlockHouse.ViewModels"
        xmlns:converters="clr-namespace:BlockHouse.Converters"
        mc:Ignorable="d"
        Title="Blockhouse Barber Shop" Height="600" Width="1000"
        WindowState="Maximized"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        Icon="/Assets/blockhouse_logo.ico"
        FontFamily="Segoe UI"
        ResizeMode="CanResize">
    <Window.Resources>
        <converters:ActiveButtonToForegroundConverter x:Key="ForegroundConverter"/>
        <converters:ActiveButtonToBackgroundConverter x:Key="BackgroundConverter"/>
        <converters:ActiveButtonToVisibilityConverter x:Key="ActiveVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="#F7F5F0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== SIDEBAR ===== -->
            <Border Grid.Column="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#111111" Offset="0"/>
                        <GradientStop Color="#1A1A1A" Offset="0.6"/>
                        <GradientStop Color="#141414" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <DockPanel LastChildFill="True">
                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,28,0,0">
                        <Border Width="64" Height="64" CornerRadius="16" Background="#222222"
                                HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Border.Effect>
                                <DropShadowEffect Color="#33C9A84C" BlurRadius="16" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <Image Source="/Assets/blockhouse_logo_transparent_white.png" Width="44" Height="44"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="BLOCKHOUSE" FontSize="14" FontWeight="Bold" Foreground="#E8E4DF"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" FontFamily="Segoe UI"/>
                        <TextBlock Text="BARBER SHOP" FontSize="10" Foreground="#78716C"
                                   HorizontalAlignment="Center" Margin="0,1,0,0" FontFamily="Segoe UI"
                                   FontWeight="SemiBold"/>

                        <Border Height="1" Background="#2A2A2A" Margin="24,24,24,0"/>
                    </StackPanel>

                    <!-- Navigation -->
                    <StackPanel DockPanel.Dock="Top" Margin="10,20,10,0">

                        <!-- Overview -->
                        <Grid Margin="0,0,0,2">
                            <Border Width="3" CornerRadius="2" HorizontalAlignment="Left" Background="#C9A84C"
                                    Margin="0,8,0,8"
                                    Visibility="{Binding ActiveButton, Converter={StaticResource ActiveVisibilityConverter}, ConverterParameter=Overview}"/>
                            <Button materialDesign:ButtonAssist.CornerRadius="10"
                                    Foreground="{Binding ActiveButton, Converter={StaticResource ForegroundConverter}, ConverterParameter=Overview}"
                                    Background="{Binding ActiveButton, Converter={StaticResource BackgroundConverter}, ConverterParameter=Overview}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Overview"
                                    Height="Auto" Padding="14,10"
                                    Style="{StaticResource MaterialDesignFlatButton}" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ViewDashboardOutline" Width="18" Height="18" Margin="0,0,12,0"
                                                 Foreground="{Binding ActiveButton, Converter={StaticResource ForegroundConverter}, ConverterParameter=Overview}"/>
                                    <TextBlock Text="Tổng quan" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"
                                       Foreground="{Binding ActiveButton, Converter={StaticResource ForegroundConverter}, ConverterParameter=Overview}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Revenue -->
                        <Grid Margin="0,0,0,2">
                            <Border Width="3" CornerRadius="2" HorizontalAlignment="Left" Background="#C9A84C"
                                    Margin="0,8,0,8"
                                    Visibility="{Binding ActiveButton, Converter={StaticResource ActiveVisibilityConverter}, ConverterParameter=Revenue}"/>
                            <Button materialDesign:ButtonAssist.CornerRadius="10"
                                    Foreground="{Binding ActiveButton, Converter={StaticResource ForegroundConverter}, ConverterParameter=Revenue}"
                                    Background="{Binding ActiveButton, Converter={StaticResource BackgroundConverter}, ConverterParameter=Revenue}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Revenue"
                                    Height="Auto" Padding="14,10"
                                    Style="{StaticResource MaterialDesignFlatButton}" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CashMultiple" Width="18" Height="18" Margin="0,0,12,0"
                                                 Foreground="{Binding ActiveButton, Converter={StaticResource ForegroundConverter}, ConverterParameter=Revenue}"/>
                                    <TextBlock Text="Doanh thu" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"
                                       Foreground="{Binding ActiveButton, Converter={StaticResource ForegroundConverter}, ConverterParameter=Revenue}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Employees -->
                        <Grid Margin="0,0,0,2">
                            <Border Width="3" CornerRadius="2" HorizontalAlignment="Left" Background="#C9A84C"
                                    Margin="0,8,0,8"
                                    Visibility="{Binding ActiveButton, Converter={StaticResource ActiveVisibilityConverter}, ConverterParameter=Employees}"/>
                            <Button materialDesign:ButtonAssist.CornerRadius="10"
                                    Foreground="{Binding ActiveButton, Converter={StaticResource ForegroundConverter}, ConverterParameter=Employees}"
                                    Background="{Binding ActiveButton, Converter={StaticResource BackgroundConverter}, ConverterParameter=Employees}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Employees"
                                    Height="Auto" Padding="14,10"
                                    Style="{StaticResource MaterialDesignFlatButton}" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="AccountGroup" Width="18" Height="18" Margin="0,0,12,0"
                                                 Foreground="{Binding ActiveButton, Converter={StaticResource ForegroundConverter}, ConverterParameter=Employees}"/>
                                    <TextBlock Text="Nhân viên" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"
                                       Foreground="{Binding ActiveButton, Converter={StaticResource ForegroundConverter}, ConverterParameter=Employees}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Services -->
                        <Grid Margin="0,0,0,2">
                            <Border Width="3" CornerRadius="2" HorizontalAlignment="Left" Background="#C9A84C"
                                    Margin="0,8,0,8"
                                    Visibility="{Binding ActiveButton, Converter={StaticResource ActiveVisibilityConverter}, ConverterParameter=Services}"/>
                            <Button materialDesign:ButtonAssist.CornerRadius="10"
                                    Foreground="{Binding ActiveButton, Converter={StaticResource ForegroundConverter}, ConverterParameter=Services}"
                                    Background="{Binding ActiveButton, Converter={StaticResource BackgroundConverter}, ConverterParameter=Services}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Services"
                                    Height="Auto" Padding="14,10"
                                    Style="{StaticResource MaterialDesignFlatButton}" Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ContentCut" Width="18" Height="18" Margin="0,0,12,0"
                                                 Foreground="{Binding ActiveButton, Converter={StaticResource ForegroundConverter}, ConverterParameter=Services}"/>
                                    <TextBlock Text="Dịch vụ" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"
                                       Foreground="{Binding ActiveButton, Converter={StaticResource ForegroundConverter}, ConverterParameter=Services}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Bottom -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,20">
                        <Border Height="1" Background="#2A2A2A" Margin="8,0,8,14"/>
                        <TextBlock Text="Version 1.0.5" HorizontalAlignment="Center" FontWeight="Normal"
                                   FontSize="10" Foreground="#525252" FontFamily="Segoe UI"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== CONTENT ===== -->
            <Border Grid.Column="1" Background="#F7F5F0" ClipToBounds="True">
                <ContentControl Content="{Binding CurrentView}" Panel.ZIndex="999" Margin="24,20"/>
            </Border>

            <!-- ===== OVERLAY ===== -->
            <Grid x:Name="OverlayGrid" Grid.ColumnSpan="2" Background="#80000000"
                  Visibility="{Binding IsOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                  Panel.ZIndex="1000"/>
        </Grid>
    </Border>
</Window>
